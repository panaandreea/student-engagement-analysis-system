<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true"
    tools:context=".fragments.MonitorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubjectGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="NO DATA YET"
                android:textColor="#2C3E50"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvSessionTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalStudents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#2C3E50"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STUDENTS"
                        android:textColor="#64748B"
                        android:textSize="10sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDominant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#059669"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATTENTION"
                        android:textColor="#64748B"
                        android:textSize="10sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Attention Flow"
                    android:textColor="#2C3E50"
                    android:textStyle="bold"/>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="5dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                app:checkedButton="@+id/btnViewComparison"
                app:singleSelection="true"
                app:cornerRadius="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewComparison"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comparison"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:strokeColor="#3E5B9B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewHeatmap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heatmap"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:strokeColor="#3E5B9B" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevComparison"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="#3E5B9B"/>

                <ImageButton
                    android:id="@+id/btnNextComparison"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="#3E5B9B"/>

            </LinearLayout>

        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableLayout
                    android:id="@+id/tableComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:stretchColumns="1,2,3"
                    android:visibility="visible">

                    <TableRow android:layout_marginBottom="12dp">

                        <TextView
                            android:text="LEVEL"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvLabelPrev"
                            android:gravity="center"
                            android:text="-"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:text=""
                            android:gravity="center"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvLabelCurr"
                            android:gravity="center"
                            android:text="CURR"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                    </TableRow>

                    <TableRow>

                        <TextView
                            android:text="LOW"
                            android:textColor="#DC2626"
                            android:fontFamily="sans-serif-bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvPrevLow"
                            android:gravity="center"
                            android:text="-"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvDeltaLow"
                            android:gravity="center"
                            android:text="-"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvCurrLow"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#DC2626"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                    </TableRow>

                    <TableRow>

                        <TextView
                            android:text="MED"
                            android:textColor="#D97706"
                            android:fontFamily="sans-serif-bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvPrevMedium"
                            android:gravity="center"
                            android:text="-"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvDeltaMed"
                            android:gravity="center"
                            android:text="-"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvCurrMedium"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#D97706"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                    </TableRow>

                    <TableRow>

                        <TextView
                            android:text="HIGH"
                            android:textColor="#059669"
                            android:fontFamily="sans-serif-bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvPrevHigh"
                            android:gravity="center"
                            android:text="-"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvDeltaHigh"
                            android:gravity="center"
                            android:text="-"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:layout_width="0dp"/>

                        <TextView
                            android:id="@+id/tvCurrHigh"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#059669"
                            android:layout_weight="1"
                            android:layout_width="0dp"/>

                    </TableRow>

                </TableLayout>

                <LinearLayout
                    android:id="@+id/layoutHeatmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSnapshotTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Snapshot -"
                        android:textColor="#2C3E50"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <ImageView
                        android:id="@+id/ivHeatmap"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="Classroom Heatmap"
                        tools:src="@android:drawable/ic_menu_gallery" />

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>