<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activities.SessionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/background_card">

        <TextView
            android:id="@+id/tvAddNewSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Session"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:gravity="center"/>

        <EditText
            android:id="@+id/etSubject"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Subject"
            android:textColor="@color/black"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:background="@drawable/background_input"/>

        <EditText
            android:id="@+id/etStudentGroup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Student group"
            android:textColor="@color/black"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:background="@drawable/background_input" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:background="@drawable/background_input">

            <TextView
                android:id="@+id/tvCamera"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:hint="Camera"
                android:textSize="18sp"
                android:textStyle="normal"/>

            <Spinner
                android:id="@+id/spCamera"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="40dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="Start time     🕒"
                android:textColor="@color/black"
                android:inputType="time"
                android:imeOptions="actionNext"
                android:background="@drawable/background_input"/>

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:hint="End time       🕒"
                android:textColor="@color/black"
                android:inputType="time"
                android:imeOptions="actionNext"
                android:background="@drawable/background_input"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etNumberOfObservations"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Number of observations"
                android:textColor="@color/black"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:background="@drawable/background_input"/>

            <Button
                android:id="@+id/btnCreateSession"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:text="Create session"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCameraInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ Camera Index 0 typically refers to the integrated webcam, while higher indexes correspond to external USB cameras."
                android:textSize="11sp"
                android:textColor="@color/black"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>